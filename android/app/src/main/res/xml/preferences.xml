<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        app:key="category_general"
        app:title="@string/preferences_category_title_general">
        <Preference
            app:key="registered_hosts"
            tools:summary="@string/preferences_registered_hosts_summary"
            app:summary=" "
            app:title="@string/preferences_registered_hosts_title"
            app:fragment="com.gameblabla.chiaki.settings.SettingsRegisteredHostsFragment"
            app:icon="@drawable/ic_console_simple"/>

        <SwitchPreference
            app:key="@string/preferences_swap_cross_moon_key"
            app:title="@string/preferences_swap_cross_moon_title"
            app:summary="@string/preferences_swap_cross_moon_summary"
            app:icon="@drawable/ic_gamepad" 
            app:defaultValue="false"
            />

        <SwitchPreference
            app:key="@string/preferences_ps_combo_enabled_key"
            app:title="@string/preferences_ps_combo_title"
            app:summary="@string/preferences_ps_combo_summary"
            app:defaultValue="true"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_auto_connect_enabled_key"
            app:title="@string/preferences_auto_connect_enabled_title"
            app:summary="@string/preferences_auto_connect_enabled_summary"
            app:defaultValue="true" />

        <SwitchPreference
            app:key="@string/preferences_hidden_ps_enabled_key"
            app:title="@string/preferences_hidden_ps_enabled_title"
            app:summary="@string/preferences_hidden_ps_enabled_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="@string/preferences_hidden_ps_visibility_key"
            app:title="@string/preferences_hidden_ps_visibility_title"
            app:summary="@string/preferences_hidden_ps_visibility_summary"
            app:entries="@array/hidden_ps_visibility_entries"
            app:entryValues="@array/hidden_ps_visibility_values"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="never" />

        <ListPreference
            app:key="@string/preferences_hidden_ps_position_key"
            app:title="@string/preferences_hidden_ps_position_title"
            app:summary="@string/preferences_hidden_ps_position_summary"
            app:entries="@array/hidden_ps_position_entries"
            app:entryValues="@array/hidden_ps_position_values"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="top_center" />

        <androidx.preference.SeekBarPreference
            app:key="@string/preferences_hidden_ps_size_key"
            app:title="@string/preferences_hidden_ps_size_title"
            app:summary="@string/preferences_hidden_ps_size_summary"
            android:max="120"
            app:min="48"
            app:seekBarIncrement="8"
            android:defaultValue="72"
            app:showSeekBarValue="true" />

        <ListPreference
            app:key="@string/preferences_touchpad_overlay_key"
            app:title="@string/preferences_touchpad_overlay_title"
            app:summary="@string/preferences_touchpad_overlay_summary"
            app:entries="@array/touchpad_overlay_entries"
            app:entryValues="@array/touchpad_overlay_values"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="while_touch" />

        <SwitchPreference
            app:key="@string/preferences_touchpad_zone_tint_key"
            app:title="@string/preferences_touchpad_zone_tint_title"
            app:summary="@string/preferences_touchpad_zone_tint_summary"
            app:defaultValue="false" />

        <androidx.preference.SeekBarPreference
            app:key="@string/preferences_rumble_strength_key"
            app:title="@string/preferences_rumble_strength_title"
            app:summary="@string/preferences_rumble_strength_summary"
            android:defaultValue="100"
            app:min="0"
            android:max="150"
            app:showSeekBarValue="true" />

        <SwitchPreference
            app:key="@string/preferences_stats_at_bottom_key"
            app:title="@string/preferences_stats_at_bottom_title"
            app:summary="@string/preferences_stats_at_bottom_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_rumble_enabled_key"
            app:title="@string/preferences_rumble_enabled_title"
            app:summary="@string/preferences_rumble_enabled_summary"
            app:icon="@drawable/ic_rumble" 
            app:defaultValue="true"
            />

        <SwitchPreference
            app:key="@string/preferences_motion_enabled_key"
            app:title="@string/preferences_motion_enabled_title"
            app:summary="@string/preferences_motion_enabled_summary"
            app:icon="@drawable/ic_motion" 
            app:defaultValue="true"
            />

        <SwitchPreference
            app:key="@string/preferences_button_haptic_enabled_key"
            app:title="@string/preferences_button_haptic_enabled_title"
            app:summary="@string/preferences_button_haptic_enabled_summary"
            app:icon="@drawable/ic_button_haptic" 
            app:defaultValue="true"
            />

        <SwitchPreference
            app:key="@string/preferences_log_verbose_key"
            app:title="@string/preferences_log_verbose_title"
            app:summary="@string/preferences_log_verbose_summary"
            app:icon="@drawable/ic_log" 
            app:defaultValue="false"
            />

        <Preference
            app:key="logs"
            app:summary="@string/preferences_logs_summary"
            app:title="@string/preferences_logs_title"
            app:fragment="com.gameblabla.chiaki.settings.SettingsLogsFragment"
            app:icon="@drawable/ic_log"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_stream"
        app:title="@string/preferences_category_title_stream">
        <ListPreference
            app:key="@string/preferences_resolution_key"
            app:title="@string/preferences_resolution_title"
            app:summary="%s"
            app:icon="@drawable/ic_resolution"/>

        <ListPreference
            app:key="@string/preferences_fps_key"
            app:title="@string/preferences_fps_title"
            app:summary="%s"
            app:icon="@drawable/ic_fps"/>

        <androidx.preference.SeekBarPreference
            app:key="@string/preferences_bitrate_key"
            app:title="@string/preferences_bitrate_title"
            app:icon="@drawable/ic_bitrate"
            android:max="100000"
            app:min="0"
            app:seekBarIncrement="1000"
            android:defaultValue="0"
            app:showSeekBarValue="false" />

        <ListPreference
            app:key="@string/preferences_codec_key"
            app:title="@string/preferences_codec_title"
            app:summary="%s"
            app:icon="@drawable/ic_codec"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_export"
        app:title="@string/preferences_category_title_export">
        <Preference
            app:key="@string/preferences_export_settings_key"
            app:summary="@string/preferences_export_settings_summary"
            app:title="@string/preferences_export_settings_title"
            app:icon="@drawable/ic_export"/>

        <Preference
            app:key="@string/preferences_import_settings_key"
            app:summary="@string/preferences_import_settings_summary"
            app:title="@string/preferences_import_settings_title"
            app:icon="@drawable/ic_import"/>
    </PreferenceCategory>
</PreferenceScreen>
